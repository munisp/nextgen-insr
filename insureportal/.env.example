# ─────────────────────────────────────────────────────────────────────────────
# InsurePortal — Complete Environment Variables Reference
# Copy this file to .env and fill in real values for your environment.
# All variables marked REQUIRED must be set; others have safe defaults.
# Generated from exhaustive audit of all 171 process.env references in server/
# ─────────────────────────────────────────────────────────────────────────────

# ── Core Application ──────────────────────────────────────────────────────────
NODE_ENV=development                        # development | staging | production
PORT=3000
APP_URL=http://localhost:3000
APP_UPSTREAM_URL=http://localhost:3000
APP_UPSTREAM_HOST=localhost
API_VERSION=v1
SERVICE_NAME=insureportal
SERVICE_VERSION=1.0.0
LOG_LEVEL=info                              # debug | info | warn | error
DEV_AUTH_BYPASS=false                       # NEVER set true in production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/insureportal   # REQUIRED
POSTGRES_URL=postgresql://user:password@localhost:5432/insureportal   # REQUIRED (alias)

# ── Authentication & Security ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-char-random-secret                       # REQUIRED
CRON_SECRET=change-me-to-a-32-char-random-secret                      # REQUIRED
INTERNAL_API_KEY=change-me-to-a-32-char-random-secret                 # REQUIRED
TX_SIGNING_SECRET=change-me-to-a-32-char-random-secret                # REQUIRED
OWNER_OPEN_ID=                              # OpenID subject of the platform owner

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080                                     # REQUIRED
KEYCLOAK_REALM=insureportal                                            # REQUIRED
KEYCLOAK_CLIENT_ID=insureportal-backend                                # REQUIRED
KEYCLOAK_CLIENT_SECRET=change-me                                       # REQUIRED

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379                                       # REQUIRED

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=insureportal
MINIO_REGION=us-east-1
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY_SECONDS=3600

# ── AWS (for production S3 / SES) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# ── SMTP / Email ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@insureportal.ng
EMAIL_FROM=noreply@insureportal.ng

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_BROKER=localhost:9092
KAFKA_BROKER_URL=localhost:9092
KAFKA_CLIENT_ID=insureportal
KAFKA_GROUP_ID=insureportal-consumer
KAFKA_ADMIN_URL=http://localhost:8082
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── OpenTelemetry / Observability ────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=insureportal
OTEL_SERVICE_VERSION=1.0.0
PROMETHEUS_METRICS_PORT=9464

# ── OpenSearch / Logging ──────────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# ── Vault (HashiCorp) ─────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=secret/insureportal

# ── Temporal Workflow Engine ──────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=insureportal-tasks

# ── Dapr Sidecar ─────────────────────────────────────────────────────────────
DAPR_APP_ID=insureportal
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# ── MQTT (IoT / Telematics) ───────────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=insureportal
MQTT_USERNAME=
MQTT_PASSWORD=

# ── mTLS ──────────────────────────────────────────────────────────────────────
MTLS_ENABLED=false
MTLS_CERT_DIR=/etc/insureportal/certs

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Push Notifications (VAPID / Web Push) ────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@insureportal.ng

# ── Nigeria Payment Gateways ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_                                           # REQUIRED for payments
PAYSTACK_PUBLIC_KEY=pk_test_
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-                                   # REQUIRED for payments
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-
INTERSWITCH_CLIENT_ID=
INTERSWITCH_CLIENT_SECRET=
REMITA_API_KEY=
REMITA_MERCHANT_ID=
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────
WHATSAPP_TOKEN=                             # Meta WhatsApp Cloud API token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token

# ── SMS (Termii) ──────────────────────────────────────────────────────────────
TERMII_API_KEY=

# ── FX Rates ──────────────────────────────────────────────────────────────────
OPEN_EXCHANGE_RATES_APP_ID=                 # https://openexchangerates.org

# ── AI / ML Built-in LLM ─────────────────────────────────────────────────────
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=https://api.openai.com/v1

# ── Permify (PBAC) ────────────────────────────────────────────────────────────
PERMIFY_URL=http://localhost:3476
PERMIFY_API_KEY=
PERMIFY_TENANT_ID=t1

# ── APISIX API Gateway ────────────────────────────────────────────────────────
APISIX_ADMIN_URL=http://localhost:9180
APISIX_ADMIN_KEY=change-me-apisix-admin-key

# ── OpenAppSec WAF ────────────────────────────────────────────────────────────
OPENAPPSEC_ENABLED=false
OPENAPPSEC_AGENT_URL=http://localhost:8090

# ── Go Infrastructure Services ────────────────────────────────────────────────
GO_INFRA_ENABLED=false
GO_INFRA_URL=http://localhost:8081
GO_LEDGER_URL=http://localhost:8082

# ── Rust Middleware ───────────────────────────────────────────────────────────
RUST_MIDDLEWARE_ENABLED=false
RUST_MIDDLEWARE_URL=http://localhost:8083
RUST_BRIDGE_URL=http://localhost:8084

# ── Python Analytics Service ──────────────────────────────────────────────────
PYTHON_ANALYTICS_ENABLED=false
PYTHON_ANALYTICS_URL=http://localhost:8001
PYTHON_ML_URL=http://localhost:8002
ANALYTICS_SERVICE_URL=http://localhost:8001
FRAUD_ML_URL=http://localhost:8002
ML_MODEL_REGISTRY_URL=http://localhost:8003

# ── Data Lakehouse ────────────────────────────────────────────────────────────
LAKEHOUSE_SERVICE_URL=http://localhost:8001
LAKEHOUSE_SERVICE_TOKEN=change-me-lakehouse-token
LAKEHOUSE_SIDECAR_URL=http://localhost:8010

# ── TigerBeetle Ledger ────────────────────────────────────────────────────────
TB_SIDECAR_URL=http://localhost:8085
TIGERBEETLE_HEALTH_URL=http://localhost:8085/health

# ── KYC / KYB Services ────────────────────────────────────────────────────────
KYC_WORKFLOW_URL=http://localhost:8090
KYC_ENFORCEMENT_URL=http://localhost:8091
KYC_EVENT_CONSUMER_URL=http://localhost:8092
KYB_ENGINE_URL=http://localhost:8093
KYB_ANALYTICS_URL=http://localhost:8094
KYB_RISK_ENGINE_URL=http://localhost:8095
DEEPFACE_URL=http://localhost:8096
DEEPFAKE_SERVICE_URL=http://localhost:8097
FACE_MATCHING_SERVICE_URL=http://localhost:8098
LIVENESS_SERVICE_URL=http://localhost:8099
BIOMETRIC_SERVICE_URL=http://localhost:8100

# ── AML / Compliance Services ─────────────────────────────────────────────────
AML_CASE_MANAGER_URL=http://localhost:8110
GOAML_SERVICE_URL=http://localhost:8111
SANCTIONS_ETL_URL=http://localhost:8112
SANCTIONS_RESCREENER_URL=http://localhost:8113
CBN_TIER_ENGINE_URL=http://localhost:8114
CBN_REPORTING_SERVICE_URL=http://localhost:8115

# ── Platform Microservices ────────────────────────────────────────────────────
PLATFORM_BASE_URL=http://localhost:8120
PLATFORM_API_KEY=change-me-platform-api-key
PLATFORM_SERVICE_TOKEN=change-me-platform-service-token
PLATFORM_NOTIFICATION_URL=http://localhost:8121
PLATFORM_FRAUD_URL=http://localhost:8122
PLATFORM_KYC_URL=http://localhost:8123
PLATFORM_SETTLEMENT_URL=http://localhost:8124
PLATFORM_DISPUTE_URL=http://localhost:8125
PLATFORM_FLOAT_URL=http://localhost:8126
PLATFORM_LOYALTY_URL=http://localhost:8127
PLATFORM_ANALYTICS_URL=http://localhost:8128
PLATFORM_GEOFENCING_URL=http://localhost:8129
PLATFORM_VIDEO_KYC_URL=http://localhost:8130

# ── Resilience & Circuit Breakers ─────────────────────────────────────────────
CIRCUIT_BREAKER_URL=http://localhost:8140
RESILIENCE_AGENT_URL=http://localhost:8141
DR_SERVICE_URL=http://localhost:8142
DDOS_SHIELD_URL=http://localhost:8143
SECURITY_FAIL_OPEN=false
SECURITY_SERVICE_TIMEOUT=5000

# ── Chaos Engineering ─────────────────────────────────────────────────────────
CHAOS_ENGINEERING_ENABLED=false

# ── Backup & Archival ─────────────────────────────────────────────────────────
BACKUP_MANAGER_URL=http://localhost:8150
DATA_ARCHIVAL_URL=http://localhost:8151

# ── Service Discovery ─────────────────────────────────────────────────────────
SERVICE_DISCOVERY_HOST=localhost
OAUTH_SERVER_URL=http://localhost:8080/realms/insureportal
SERVICE_AUTH_URL=http://localhost:8080/realms/insureportal/protocol/openid-connect/token
PBAC_ENGINE_URL=http://localhost:3476

# ── Fluvio Streaming ──────────────────────────────────────────────────────────
FLUVIO_ENDPOINT=localhost:9003
FLUVIO_HTTP_URL=http://localhost:9003
FLUVIO_API_KEY=

# ── Mojaloop ──────────────────────────────────────────────────────────────────
MOJALOOP_SIDECAR_URL=http://localhost:8160

# ── MDM (Mobile Device Management) ───────────────────────────────────────────
MDM_COMPLIANCE_ENGINE_URL=http://localhost:8170
MDM_GEOFENCE_SERVICE_URL=http://localhost:8171

# ── POS Services ──────────────────────────────────────────────────────────────
POS_PRINTER_URL=http://localhost:8180

# ── Supply Chain & Marketplace ────────────────────────────────────────────────
SUPPLY_CHAIN_URL=http://localhost:8190
MARKETPLACE_URL=http://localhost:8191
CART_SERVICE_URL=http://localhost:8192
CATALOG_SERVICE_URL=http://localhost:8193

# ── Offline Queue ─────────────────────────────────────────────────────────────
OFFLINE_QUEUE_URL=http://localhost:8200

# ── Webhook Delivery ──────────────────────────────────────────────────────────
WEBHOOK_DELIVERY_URL=http://localhost:8210

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_APP_ID=insureportal
VITE_ANALYTICS_ENDPOINT=http://localhost:8001/analytics
