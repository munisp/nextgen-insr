  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "documents",
          "accept": [
            "application/pdf",
            "image/*"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "prefer_related_applications": false,
  "related_applications": [],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
