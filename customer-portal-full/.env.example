# ═══════════════════════════════════════════════════════════════════════
# InsurePortal — Environment Variables
# Copy to .env and fill in values for your environment
# ═══════════════════════════════════════════════════════════════════════

# ─── Server ───
PORT=5002
LOG_LEVEL=info                    # trace | debug | info | warn | error | fatal

# ─── PostgreSQL ───
PGHOST=localhost
PGPORT=5432
PGDATABASE=ngapp
PGUSER=postgres
PGPASSWORD=
PG_MAX_CONNECTIONS=20
PG_MIN_CONNECTIONS=2
PG_IDLE_TIMEOUT=30000             # ms — close idle connections after this
PG_CONNECT_TIMEOUT=5000           # ms — timeout for new connections
PG_STATEMENT_TIMEOUT=30000        # ms — kill queries running longer than this

# ─── PostgreSQL Read Replica (optional) ───
PG_REPLICA_HOST=
PG_REPLICA_PORT=5432
PG_REPLICA_USER=
PG_REPLICA_PASSWORD=
PG_REPLICA_MAX=5

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Authentication ───
JWT_SECRET=                       # REQUIRED in production — random 64+ char string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Auth Enforcement ───
AUTH_STRICT=false                 # Set to true to require auth on ALL routes (including reads)
                                  # Mutations always require auth regardless of this setting

# ─── CORS ───
CORS_ORIGINS=http://localhost:5002,http://localhost:5173,http://localhost:3000

# ─── CSRF ───
CSRF_ENABLED=false                # Enable CSRF token validation

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW=60000           # ms — sliding window size
RATE_LIMIT_MAX=100                # max requests per window

# ─── Email (SMTP) ───
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=InsurePortal <noreply@insureportal.ng>

# ─── SMS (Termii) ───
TERMII_API_KEY=

# ─── File Upload ───
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760            # 10MB in bytes

# ─── AWS S3 (optional — falls back to local disk) ───
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# ─── ML Inference (optional — falls back to rule engine) ───
ML_INFERENCE_URL=                 # e.g. http://localhost:8100

# ─── Kafka (optional — events logged locally if disabled) ───
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092

# ─── TigerBeetle Ledger (optional) ───
TIGERBEETLE_ENABLED=false
TB_ADDRESSES=3000

# ─── OpenSearch (optional — falls back to ILIKE queries) ───
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ─── Multi-Tenancy (optional) ───
MULTI_TENANT=false                # Enable X-Tenant-ID header support
