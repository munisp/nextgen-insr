#!/bin/sh
# Pre-commit hook: TypeScript type check + console.log ban + client tests
# This hook runs before each commit to prevent regressions.

set -e

echo "🔍 Running pre-commit checks..."

# ── 1. TypeScript type check on changed files ──────────────────────────────────
echo "📝 Type-checking changed TypeScript files..."
CHANGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ts$' | grep -v '\.d\.ts$' | grep -v '\.test\.' || true)

if [ -n "$CHANGED_TS_FILES" ]; then
    npx tsc --noEmit --skipLibCheck $CHANGED_TS_FILES 2>&1 || {
        echo ""
        echo "❌ TypeScript type check failed. Fix the errors above before committing."
        exit 1
    }
    echo "✅ TypeScript type check passed."
fi

# ── 2. Ban console.log in server files ─────────────────────────────────────────
echo "🔍 Checking for console.log in server files..."
CONSOLE_LOGS=$(git diff --cached --unified=0 -- 'server/*.ts' 'server/**/*.ts' | grep '+.*console\.log\|+.*console\.info\|+.*console\.debug' | grep -v 'logger\.' || true)

if [ -n "$CONSOLE_LOGS" ]; then
    echo ""
    echo "❌ Found console.log/console.info/console.debug in server files."
    echo "   Use the Pino logger instead: import { logger } from './_core/logger'"
    echo "   Then replace console.log() → logger.info()"
    echo ""
    echo "   Offending lines:"
    echo "$CONSOLE_LOGS"
    exit 1
fi
echo "✅ No console.log found in server files."

# ── 3. Ban @ts-nocheck ─────────────────────────────────────────────────────────
echo "🔍 Checking for @ts-nocheck..."
TS_NOCHECK=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ts$' | grep -v '\.d\.ts$' | xargs grep -l '@ts-nocheck' 2>/dev/null || true)

if [ -n "$TS_NOCHECK" ]; then
    echo ""
    echo "❌ Found @ts-nocheck in the following files:"
    echo "$TS_NOCHECK"
    echo "   Use @ts-check and fix type errors instead of suppressing them."
    exit 1
fi
echo "✅ No @ts-nocheck found."

# ── 4. Run client tests (if any test files are staged or if vitest exists) ─────
echo "🧪 Running client tests..."
if [ -f "package.json" ] && grep -q '"test"' package.json 2>/dev/null; then
    npm test 2>&1 || {
        echo ""
        echo "❌ Tests failed. Fix the tests before committing."
        exit 1
    }
    echo "✅ All tests passed."
else
    echo "⏭️  No test script found, skipping."
fi

echo ""
echo "✅ All pre-commit checks passed!"
