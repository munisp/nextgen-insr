# ══════════════════════════════════════════════════════════════════════════════
# NGApp Platform — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in production values before deployment.
# All variables referenced by Go config files, TypeScript services,
# Helm charts, Docker Compose files, and monitoring configs are listed here.
#
# Sources: claims-adjudication-engine/config/config.go
#          fraud-detection-go/config/config.go
#          ussd-gateway/main.go
#          enhanced-kyc-kyb/config/config.go
#          shared/config/config.go
#          insureportal/shared/config/config.go
#          server/db.ts, server/_core/env.ts, server/lib/envValidation.ts
#          server/_core/envValidation.ts
#          deploy/staging/docker-compose.staging.yml
#          helm/ngapp-platform/values.yaml, helm/ngapp-platform/templates/
#          monitoring/prometheus-values.yaml
# ══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# CORE APPLICATION
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Valid values: production, development, test
PORT=3000
# HTTP port for the main Express server (server/_core/env.ts)
APP_URL=https://your-domain.com
# Public-facing application URL
APP_UPSTREAM_URL=http://localhost:3000
# Internal upstream URL (Docker services)
APP_UPSTREAM_HOST=localhost:3000
API_VERSION=v1
# API version prefix (e.g. /api/v1)
SERVICE_NAME=ngapp
# Human-readable service name (used by Go microservices)
SERVICE_VERSION=1.0.0
# Semantic version string
ENVIRONMENT=production
# Alias for NODE_ENV used by shared Go services (shared/config/config.go)

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ─────────────────────────────────════════════════════════════════════════════
# Used by: server/db.ts, claims-adjudication-engine, fraud-detection-go,
#          ussd-gateway, enhanced-kyc-kyb, shared/config, insureportal/config
# ── Connection ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@db-host:5432/ngapp?sslmode=require
# Full PostgreSQL connection string (shared/config, server/db.ts)
POSTGRES_URL=postgres://user:password@db-host:5432/ngapp?sslmode=require
# Alias for DATABASE_URL used by server/_core/env.ts
DB_HOST=localhost
# PostgreSQL host (claims-adjudication-engine, fraud-detection-go, enhanced-kyc-kyb)
DB_PORT=5432
# PostgreSQL port
DB_USER=ngapp
# PostgreSQL username
DB_PASSWORD=
# PostgreSQL password — set in production
DB_NAME=ngapp
# PostgreSQL database name
DB_SSL_MODE=prefer
# SSL mode: disable, allow, prefer, require, verify-ca, verify-full
# Used by: claims-adjudication-engine/config/config.go
DB_SSLMODE=disable
# Alias for DB_SSL_MODE (fraud-detection-go uses DB_SSLMODE)
# Used by: fraud-detection-go/config/config.go
# ── Connection Pool ──────────────────────────────────────────────────────────
DB_MAX_OPEN_CONNS=25
# Max open DB connections (claims-adjudication-engine, fraud-detection-go)
DB_MAX_IDLE_CONNS=5
# Max idle DB connections (claims-adjudication-engine, fraud-detection-go)
DB_CONN_MAX_LIFETIME=5m
# Max time a connection can live (claims-adjudication-engine)
DB_CONN_MAX_IDLE_TIME=3m
# Max time an idle connection is kept (claims-adjudication-engine)
DB_CONN_MAX_LIFE=10m
# Alias for DB_CONN_MAX_LIFETIME (fraud-detection-go)
# ── Shared Go Service Config (shared/config, insureportal/config) ────────────
DATABASE_HOST=localhost
# Alias for DB_HOST (shared/config/config.go)
DATABASE_PORT=5432
# Alias for DB_PORT (shared/config/config.go)
DATABASE_NAME=ngapp
# Default database name per service (shared/config/config.go)
DATABASE_USER=postgres
# Default database user (shared/config/config.go)
DATABASE_PASSWORD=
# Default database password (shared/config/config.go)
DATABASE_SSL_MODE=disable
# Default SSL mode (shared/config/config.go)
DATABASE_MAX_CONNS=25
# Default max connections (shared/config/config.go)
DATABASE_MIN_CONNS=5
# Default min connections (shared/config/config.go)
# ── Enhanced KYC/KYB ────────────────────────────────────────────────────────
DB_MAX_CONNS=25
# Max DB connections for enhanced-kyc-kyb
DB_MIN_CONNS=5
# Min DB connections for enhanced-kyc-kyb
DB_MAX_LIFETIME=30m
# Max connection lifetime for enhanced-kyc-kyb
DB_MAX_IDLE_TIME=15m
# Max idle connection time for enhanced-kyc-kyb

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────════════════════════════════
# Used by: server/_core/env.ts, claims-adjudication-engine, fraud-detection-go,
#          ussd-gateway, enhanced-kyc-kyb, shared/config, insureportal/config
# ── Connection ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis-host:6379
# Full Redis URL (shared/config, server/_core/env.ts)
REDIS_HOST=redis-host
# Redis host (claims-adjudication-engine, fraud-detection-go)
REDIS_PORT=6379
# Redis port
REDIS_PASSWORD=
# Redis password — set in production
REDIS_DB=0
# Redis database number
REDIS_ADDR=localhost:6379
# Redis host:port format (enhanced-kyc-kyb, ussd-gateway)
# ── Connection Pool ──────────────────────────────────────────────────────────
REDIS_MAX_RETRIES=3
# Redis connection retry count (claims-adjudication-engine, fraud-detection-go)
REDIS_POOL_SIZE=10
# Redis connection pool size (claims-adjudication-engine, fraud-detection-go)
REDIS_MIN_CONNS=2
# Redis minimum connections in pool (claims-adjudication-engine, fraud-detection-go)
REDIS_CONN_MAX_IDLE_TIME=3m
# Max idle time for Redis connections (claims-adjudication-engine)
REDIS_DIAL_TIMEOUT=5s
# Redis dial/connect timeout (fraud-detection-go)
REDIS_READ_TIMEOUT=3s
# Redis read timeout (fraud-detection-go)
REDIS_WRITE_TIMEOUT=3s
# Redis write timeout (fraud-detection-go)
# ── Cluster Mode ─────────────────────────────────────────────────────────────
REDIS_CLUSTER_MODE=false
# Enable Redis cluster mode (claims-adjudication-engine)
REDIS_CLUSTER_NODES=kafka-1:6379,kafka-2:6379
# Redis cluster node addresses (claims-adjudication-engine)

# ─────────────────────────────────────────────────────────────────────────────
# KAFKA (Message Broker)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine, server/_core/env.ts, Helm microservices,
#          server/lib/envValidation.ts, shared/config, insureportal/config
# ── Connection ───────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092
# Comma-separated Kafka broker addresses
KAFKA_BROKER=kafka-1:9092
# Single Kafka broker (legacy)
KAFKA_BROKER_HOST=kafka-1
# Kafka broker host
KAFKA_BROKER_PORT=9092
# Kafka broker port
KAFKA_BROKER_URL=kafka-1:9092
# Kafka broker URL (legacy)
KAFKA_CLIENT_ID=ngapp-producer
# Kafka producer client ID (shared/config, insureportal/config)
KAFKA_GROUP_ID=ngapp-consumers
# Kafka consumer group ID (legacy)
KAFKA_CONSUMER_GROUP=ngapp-consumers
# Kafka consumer group (shared/config, insureportal/config)
KAFKA_ENABLED=true
# Enable Kafka integration (server/_core/env.ts)
KAFKA_SSL=true
# Enable SSL for Kafka connections (server/_core/env.ts)
# ── SASL Authentication ─────────────────────────────────────────────────────
KAFKA_SASL_USERNAME=
# Kafka SASL username — set in production
KAFKA_SASL_PASSWORD=
# Kafka SASL password — set in production
# ── Kafka Admin / Schema Registry ────────────────────────────────────────────
KAFKA_ADMIN_URL=http://kafka-admin:8083
# Kafka Admin REST API URL
SCHEMA_REGISTRY_URL=http://schema-registry:8081
# Confluent Schema Registry URL
# ── Kafka Topics / Consumer ──────────────────────────────────────────────────
KAFKA_TOPIC_PREFIX=ngapp
# Prefix for all Kafka topic names (claims-adjudication-engine)
KAFKA_MAX_RETRY=3
# Max Kafka send retries (claims-adjudication-engine)
KAFKA_COMMIT_INTERVAL=1s
# Kafka offset commit interval (claims-adjudication-engine)

# ─────────────────────────────────────────────────────────────────────────────
# TEMPORAL (Workflow Orchestration)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine, server/_core/env.ts,
#          server/_core/envValidation.ts, Docker Compose staging
# ── Connection ───────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
# Temporal gRPC address (server/_core/env.ts, Docker Compose staging)
TEMPORAL_HOST_PORT=localhost:7233
# Temporal host:port format (claims-adjudication-engine)
TEMPORAL_NAMESPACE=ngapp
# Temporal workflow namespace
TEMPORAL_TASK_QUEUE=ngapp-tasks
# Default Temporal task queue
TEMPORAL_MAX_CONNS=100
# Max Temporal client connections (claims-adjudication-engine)
TEMPORAL_HOST=temporal:7233
# Temporal host (Helm microservices template)

# ─────────────────────────────────────────────────────────────────────────────
# KEYCLOAK (Authentication / OIDC)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, shared/config, insureportal/config,
#          server/lib/envValidation.ts, server/_core/envValidation.ts,
#          Docker Compose staging, Helm microservices
# ── OIDC Connection ──────────────────────────────────────────────────────────
KEYCLOAK_URL=https://auth.your-domain.com
# Keycloak server URL
KEYCLOAK_REALM=ngapp
# Keycloak realm name
KEYCLOAK_CLIENT_ID=ngapp-client
# Keycloak OIDC client ID
KEYCLOAK_CLIENT_SECRET=
# Keycloak OIDC client secret — required in production (server/lib/envValidation.ts)
OAUTH_SERVER_URL=https://auth.your-domain.com
# OAuth server URL (alternative name, used in server/_core/env.ts)
# ── Keycloak Admin (Docker Compose staging) ──────────────────────────────────
KEYCLOAK_ADMIN=admin
# Keycloak admin username (staging)
KEYCLOAK_ADMIN_PASSWORD=admin
# Keycloak admin password — override in production
KC_DB=postgres
# Keycloak database type (staging)
KC_DB_URL=jdbc:postgresql://postgres:5432/ngapp_staging
# Keycloak database URL (staging)
KC_DB_USERNAME=ngapp
# Keycloak database username (staging)

# ─────────────────────────────────────────────────────────────────────────────
# OPENSEARCH (Search & Analytics)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: Docker Compose staging, Helm microservices
# ── Connection ───────────────────────────────────────────────────────────────
OPENSEARCH_URL=https://opensearch:9200
# OpenSearch HTTP URL
OPENSEARCH_ENDPOINT=https://opensearch:9200
# OpenSearch endpoint alias
OPENSEARCH_USER=admin
# OpenSearch username
OPENSEARCH_PASSWORD=
# OpenSearch password — set in production
OPENSEARCH_ANALYTICS_URL=http://analytics-service:8093
# OpenSearch analytics service URL
# ── OpenSearch JVM (Docker Compose staging) ──────────────────────────────────
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# OpenSearch JVM options (staging)

# ─────────────────────────────────────────────────────────────────────────────
# PERMIFY (Authorization)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts
PERMIFY_URL=http://permify:3476
# Permify gRPC/HTTP URL
PERMIFY_HOST=permify
# Permify host
PERMIFY_PORT=3476
# Permify port
PERMIFY_API_KEY=
# Permify API key — required in production (server/lib/envValidation.ts)
PERMIFY_TENANT_ID=
# Permify tenant ID for multi-tenant setups
PERMIFY_ENABLED=true
# Enable Permify authorization

# ─────────────────────────────────────────────────────────────────────────────
# TIGERBEETLE (Double-Entry Ledger)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts
TIGERBEETLE_HOST=tigerbeetle
# TigerBeetle host
TIGERBEETLE_PORT=3320
# TigerBeetle port
TIGERBEETLE_CLUSTER_ID=0
# TigerBeetle cluster identifier
TIGERBEETLE_HEALTH_URL=http://tigerbeetle:9090
# TigerBeetle health check endpoint
TIGERBEETLE_INTEGRATED_URL=http://tigerbeetle-service:8082
# TigerBeetle integrated service URL
TB_SIDECAR_URL=http://tigerbeetle-sidecar:3320
# TigerBeetle sidecar URL (server/_core/env.ts)
GO_LEDGER_URL=http://ledger-service:8301
# Go ledger service URL

# ─────────────────────────────────────────────────────────────────────────────
# MOJALOOK (Payments)
# ─────────────────────────────────────────────────────────────────────────────
MOJALOOP_HUB_URL=http://mojaloop-hub:4001
# MoJaloop hub payment URL
MOJALOOP_DFSP_ID=ngapp-dfsp
# MoJaloop DFSP (Digital Financial Service Provider) identifier
MOJALOOP_SIDECAR_URL=http://mojaloop-sidecar:4002
# MoJaloop sidecar URL

# ─────────────────────────────────────────────────────────────────────────────
# APISIX (API Gateway)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, server/lib/envValidation.ts
APISIX_ADMIN_URL=http://apisix:9180
# APISIX admin API URL
APISIX_ADMIN_KEY=
# APISIX admin API key — required in production (server/lib/envValidation.ts)

# ─────────────────────────────────────────────────────────────────────────────
# OTEL / OBSERVABILITY (OpenTelemetry)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine, server/_core/env.ts,
#          server/lib/envValidation.ts, server/_core/envValidation.ts
# ── OpenTelemetry ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OpenTelemetry OTLP collector endpoint (server/_core/env.ts, server/lib/envValidation.ts)
OTEL_SERVICE_NAME=ngapp
# OpenTelemetry service name
OTEL_SERVICE_VERSION=1.0.0
# OpenTelemetry service version
OTEL_ENDPOINT=
# OpenTelemetry endpoint (claims-adjudication-engine — may be set for per-service override)
SERVICE_NAME=ngapp
# Service name used for OTel service name (claims-adjudication-engine)
# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Log level: debug, info, warn, error (claims-adjudication-engine, fraud-detection-go,
#          enhanced-kyc-kyb, ussd-gateway, shared/config, insureportal/config)
LOG_FORMAT=json
# Log format: json, console (claims-adjudication-engine, shared/config, insureportal/config)
# ── Observability Toggle ─────────────────────────────────────────────────────
OBSERVABILITY_ENABLED=true
# Enable observability (claims-adjudication-engine)
# ── Jaeger (Tracing) ─────────────────────────────────────────────────────────
JAEGER_ENDPOINT=http://localhost:14268/api/traces
# Jaeger collector endpoint (shared/config, insureportal/config)
# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
# Prometheus metrics scrape port (claims-adjudication-engine)
PROMETHEUS_ENABLED=true
# Enable Prometheus metrics endpoint (shared/config, insureportal/config)

# ─────────────────────────────────────────────────────────────────────────────
# SERVER (HTTP Server Configuration)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine, fraud-detection-go, shared/config,
#          insureportal/config
# ── Main Server ──────────────────────────────────────────────────────────────
SERVER_PORT=3000
# Main server HTTP port (server/_core/env.ts via PORT, claims-adjudication-engine=8090,
#          fraud-detection-go=8109, shared/config=8080)
SERVER_ENVIRONMENT=production
# Server environment (claims-adjudication-engine)
SERVER_ENV=development
# Alias for SERVER_ENVIRONMENT (fraud-detection-go)
# ── Timeouts ─────────────────────────────────────────────────────────────────
SERVER_READ_TIMEOUT=15s
# HTTP read timeout (claims-adjudication-engine=15s, fraud-detection-go=5s)
SERVER_WRITE_TIMEOUT=15s
# HTTP write timeout (claims-adjudication-engine=15s, fraud-detection-go=10s)
SERVER_SHUTDOWN_TIMEOUT=30s
# Graceful shutdown timeout (claims-adjudication-engine)
SERVER_IDLE_TIMEOUT=60s
# HTTP idle timeout (fraud-detection-go, shared/config=120s)
SERVER_MAX_REQUEST_BODY=10485760
# Max request body size in bytes (claims-adjudication-engine, default 10MB)
# ── Shared Go Service Timeouts ───────────────────────────────────────────────
HTTP_PORT=8080
# HTTP server port (shared/config, insureportal/config)
GRPC_PORT=9090
# gRPC server port (shared/config, insureportal/config)
METRICS_PORT=9091
# Metrics endpoint port (shared/config, insureportal/config)
HEALTH_PORT=8081
# Health check endpoint port (shared/config, insureportal/config)
READ_TIMEOUT=30s
# Read timeout (shared/config, insureportal/config)
WRITE_TIMEOUT=30s
# Write timeout (shared/config, insureportal/config)
IDLE_TIMEOUT=120s
# Idle timeout (shared/config, insureportal/config)
SHUTDOWN_TIMEOUT=30s
# Shutdown timeout (shared/config, insureportal/config)
# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-domain.com
# Comma-separated list of allowed CORS origins (server/_core/env.ts via CORS_ALLOWED_ORIGINS)
CORS_ALLOWED_ORIGINS=*
# CORS allowed origins (shared/config, insureportal/config)

# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine, enhanced-kyc-kyb
# ── Global Rate Limiter ──────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
# Enable global API rate limiting (claims-adjudication-engine)
RATE_LIMIT_RPS=100
# Requests per second limit (claims-adjudication-engine)
RATE_LIMIT_BURST=200
# Max burst size (claims-adjudication-engine)
RATE_LIMIT_WINDOW=1m
# Rate limit window duration (claims-adjudication-engine)
RATE_LIMIT_POLICY_WINDOW=1h
# Max claims per policy window (claims-adjudication-engine)
RATE_LIMIT_MAX_PER_DAY=10
# Max claims per day per user (claims-adjudication-engine)
# ── KYC Rate Limiters ────────────────────────────────────────────────────────
RATE_LIMIT_NIN=10
# Max NIN verification attempts per window (enhanced-kyc-kyb)
RATE_LIMIT_BVN=10
# Max BVN verification attempts per window (enhanced-kyc-kyb)
RATE_LIMIT_WINDOW=1h
# KYC rate limit window (enhanced-kyc-kyb)

# ─────────────────────────────────────────────────────────────────────────────
# SLA (Service Level Agreements)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine
SLA_AUTO_APPROVAL_HOURS=48
# Auto-approve claims after N hours (claims-adjudication-engine)
SLA_SUPERVISOR_REVIEW_HOURS=72
# Supervisor review deadline in hours (claims-adjudication-engine)
SLA_EXECUTIVE_APPROVAL_DAYS=5
# Executive approval deadline in days (claims-adjudication-engine)
SLA_FRAUD_INVESTIGATION_DAYS=10
# Fraud investigation deadline in days (claims-adjudication-engine)

# ─────────────────────────────────────────────────────────────────────────────
# MINIO / S3 (Object Storage)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: claims-adjudication-engine, server/_core/env.ts, server/lib/envValidation.ts
# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=https://s3.your-domain.com
# MinIO/S3 endpoint URL (server/_core/env.ts)
MINIO_ACCESS_KEY=
# MinIO access key — required in production (server/lib/envValidation.ts)
MINIO_SECRET_KEY=
# MinIO secret key — required in production (server/lib/envValidation.ts)
MINIO_BUCKET=ngapp-uploads
# Default S3 bucket name
MINIO_REGION=us-east-1
# S3 region
MINIO_URL=localhost:9000
# MinIO URL (claims-adjudication-engine)
# ── S3 ───────────────────────────────────────────────────────────────────────
S3_REGION=us-east-1
# AWS S3 region
S3_PRESIGN_EXPIRY_SECONDS=3600
# S3 presigned URL expiry in seconds (server/_core/env.ts)

# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (Payment Processing)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Stripe API secret key
STRIPE_WEBHOOK_SECRET=
# Stripe webhook signing secret

# ─────────────────────────────────────────────────────────────────────────────
# SMS / NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, server/lib/envValidation.ts
# ── Termii ───────────────────────────────────────────────────────────────────
TERMII_API_KEY=
# Termii SMS API key — required in production (server/lib/envValidation.ts)
TERMII_SENDER_ID=NGApp
# Termii sender ID (shown to recipients)
# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
# Twilio Account SID
TWILIO_AUTH_TOKEN=
# Twilio Auth Token
TWILIO_FROM_NUMBER=
# Twilio verified phone number
TWILIO_PHONE_NUMBER=
# Alias for TWILIO_FROM_NUMBER
# ── Africa's Talking ─────────────────────────────────────────────────────────
AT_API_KEY=
# Africa's Talking API key
AT_USERNAME=
# Africa's Talking username
AT_SENDER_ID=NGApp
# Africa's Talking sender ID

# ─────────────────────────────────────────────────────────────────────────────
# ENHANCED KYC/KYB (Identity Verification)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: enhanced-kyc-kyb/config/config.go
KYC_PORT=8121
# KYC service HTTP port
PORT=8121
# Port for enhanced-kyc-kyb (shared PORT across services, set to 8121 here)
NIN_API_URL=http://localhost:9001/api/v1/nin/verify
# NIN (National Identification Number) verification API
NIN_API_KEY=
# NIN API authentication key
BVN_API_URL=http://localhost:9001/api/v1/bvn/verify
# BVN (Bank Verification Number) verification API
BVN_API_KEY=
# BVN API authentication key
NIN_RETRY_ATTEMPTS=3
# NIN API retry attempts on failure
BVN_RETRY_ATTEMPTS=3
# BVN API retry attempts on failure
NIN_RETRY_DELAY=1s
# NIN API delay between retries
BVN_RETRY_DELAY=1s
# BVN API delay between retries
KYC_TTL=17520h
# KYC data retention TTL (2 years in hours)
KYB_TTL=8760h
# KYB data retention TTL (1 year in hours)
AUDIT_RETENTION=61320h
# Audit log retention period (7 years in hours)

# ─────────────────────────────────────────────────────────────────────────────
# FRAUD DETECTION
# ─────────────────────────────────────────────────────────────────────────────
# Used by: fraud-detection-go/config/config.go
FRAUD_PORT=8102
# Fraud detection service HTTP port
FRAUD_STR_THRESHOLD=5000000
# Suspicious Transaction Report threshold (in smallest currency unit)
FRAUD_BLOCK_SCORE=80
# Transaction score above which transactions are blocked (0-100)
FRAUD_REVIEW_SCORE=60
# Transaction score above which transactions are flagged for review (0-100)
FRAUD_VELOCITY_WINDOW=1h
# Velocity check time window
FRAUD_VELOCITY_THRESHOLD=20
# Max transactions per velocity window
FRAUD_BLOCK_TTL=24h
# How long a block persists before expiring

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, shared/config, insureportal/config,
#          server/lib/envValidation.ts
# ── Cryptography ─────────────────────────────────────────────────────────────
JWT_SECRET=
# JWT signing secret (min 32 chars) — required in production (server/lib/envValidation.ts)
ENCRYPTION_KEY=
# AES/Data encryption key — required in production (shared/config)
API_KEY_HEADER=X-API-Key
# Standard API key request header name (shared/config)
TX_SIGNING_SECRET=
# HMAC secret for transaction payload signing — required in production (server/lib/envValidation.ts)
# ── mTLS ─────────────────────────────────────────────────────────────────────
MTLS_ENABLED=false
# Enable mutual TLS (server/_core/env.ts)
MTLS_CERT_DIR=/etc/certs
# Directory containing mTLS certificates (server/_core/env.ts)
# ── OpenAppSec / WAF ─────────────────────────────────────────────────────────
DDOS_SHIELD_URL=http://openappsec:7777
# OpenAppSec/DDoS shield URL
SECURITY_SERVICE_TIMEOUT=5000
# Security service timeout in milliseconds
SECURITY_FAIL_OPEN=false
# Allow requests if security service is unavailable

# ─────────────────────────────────────────────────────────────────────────────
# HASHICORP VAULT (Secrets Management)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, server/lib/envValidation.ts
VAULT_ADDR=http://vault:8200
# HashiCorp Vault API URL
VAULT_ROLE_ID=
# Vault AppRole role ID
VAULT_SECRET_ID=
# Vault AppRole secret ID
VAULT_SECRET_PATH=secret/data/ngapp
# Vault secret path for application secrets
VAULT_ROLE_ID=
# Vault role ID — required in production (server/lib/envValidation.ts)

# ─────────────────────────────────────────────────────────────────────────────
# DAPR (Distributed Application Runtime / Service Mesh)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: shared/config, insureportal/config
DAPR_HTTP_PORT=3500
# Dapr HTTP API port
DAPR_GRPC_PORT=50001
# Dapr gRPC port
DAPR_PUBSUB_NAME=pubsub
# Dapr Pub/Sub component name
DAPR_STATE_STORE=statestore
# Dapr state store component name

# ─────────────────────────────────────────────────────────────────────────────
# FLUVIO (Event Streaming)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts
FLUVIO_HTTP_URL=http://fluvio:9090
# Fluvio HTTP URL
FLUVIO_HOST=fluvio
# Fluvio host
FLUVIO_PORT=9003
# Fluvio service port
FLUVIO_ENDPOINT=http://fluvio:9003
# Fluvio endpoint (server/_core/env.ts)
FLUVIO_API_KEY=
# Fluvio API key — required in production (server/lib/envValidation.ts)
FLUVIO_STREAMING_URL=http://fluvio:8095
# Fluvio streaming cluster URL

# ─────────────────────────────────────────────────────────────────────────────
# MQTT (IoT Broker)
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, server/lib/envValidation.ts
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
# MQTT broker URL
MQTT_CLIENT_ID=ngapp-iot
# MQTT client identifier
MQTT_USERNAME=
# MQTT broker username
MQTT_PASSWORD=
# MQTT broker password — required in production (server/lib/envValidation.ts)

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.your-domain.com
# SMTP server hostname
SMTP_PORT=587
# SMTP port (STARTTLS)
SMTP_SECURE=false
# Use TLS for SMTP
SMTP_USER=
# SMTP authentication username
SMTP_PASS=
# SMTP authentication password
SMTP_FROM=noreply@your-domain.com
# Default "From" email address
EMAIL_FROM=noreply@your-domain.com
# Alias for SMTP_FROM
SENDGRID_API_KEY=
# SendGrid email API key

# ─────────────────────────────────────────────────────────────────────────────
# PUSH NOTIFICATIONS (Web Push / VAPID)
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
# VAPID public key (Web Push)
VAPID_PRIVATE_KEY=
# VAPID private key (Web Push)
VAPID_SUBJECT=mailto:admin@your-domain.com
# VAPID contact email

# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM API / AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts, server/lib/envValidation.ts
PLATFORM_BASE_URL=https://your-domain.com
# Platform base URL
PLATFORM_API_KEY=
# Platform API key — required in production (server/lib/envValidation.ts)
PLATFORM_SERVICE_TOKEN=
# Platform service-to-service token — required in production (server/lib/envValidation.ts)
INTERNAL_API_KEY=
# Service-to-service auth key (X-Internal-Key header) — required in production (server/lib/envValidation.ts)
CRON_SECRET=
# Shared secret for cron/scheduler API calls — required in production (server/lib/envValidation.ts)
DEV_AUTH_BYPASS=false
# Bypass authentication in dev mode

# ─────────────────────────────────────────────────────────────────────────────
# BIOMETRIC / KYC SERVICE URLs
# ─────────────────────────────────────────────────────────────────────────────
BIOMETRIC_SERVICE_URL=http://biometric-service:8046
# Biometric verification service URL
LIVENESS_SERVICE_URL=http://liveness-service:8104
# Liveness detection service URL
FACE_MATCHING_SERVICE_URL=http://face-matching:8105
# Face matching service URL
DEEPFAKE_SERVICE_URL=http://deepfake-detection:8106
# Deepfake detection service URL
DEEPFACE_URL=http://deepface:8133
# DeepFace analysis service URL

# ─────────────────────────────────────────────────────────────────────────────
# KYC / KYB WORKFLOW SERVICE URLs
# ─────────────────────────────────────────────────────────────────────────────
KYC_WORKFLOW_URL=http://kyc-workflow:8080
# KYC workflow engine URL
KYC_ENFORCEMENT_URL=http://kyc-enforcement:8080
# KYC enforcement service URL
KYC_EVENT_CONSUMER_URL=http://kyc-events:8080
# KYC event consumer URL
KYB_ENGINE_URL=http://kyb-engine:8080
# KYB (Know Your Business) engine URL
KYB_ANALYTICS_URL=http://kyb-analytics:8080
# KYB analytics service URL
KYB_RISK_ENGINE_URL=http://kyb-risk:8080
# KYB risk scoring engine URL

# ─────────────────────────────────────────────────────────────────────────────
# COMPLIANCE / AML / SANCTIONS
# ─────────────────────────────────────────────────────────────────────────────
COMPLIANCE_API_URL=http://compliance:8080
# Compliance service URL
COMPLIANCE_API_KEY=
# Compliance API key
GOAML_SERVICE_URL=http://goaml:8080
# GOAML (Financial Intelligence Unit) reporting URL
SANCTIONS_ETL_URL=http://sanctions-etl:8080
# Sanctions data ETL pipeline URL
SANCTIONS_RESCREENER_URL=http://sanctions-rescreener:8080
# Sanctions re-screener service URL
OFAC_SDN_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
# OFAC SDN list XML feed URL
AML_CASE_MANAGER_URL=http://aml-case-manager:8080
# AML case management service URL

# ─────────────────────────────────────────────────────────────────────────────
# GO MICROSERVICE URLs
# ─────────────────────────────────────────────────────────────────────────────
WORKFLOW_ORCHESTRATOR_URL=http://workflow-orchestrator:8081
# Workflow orchestrator service URL
MDM_COMPLIANCE_URL=http://mdm-compliance:8083
# MDM compliance service URL
MDM_COMPLIANCE_ENGINE_URL=http://mdm-engine:8083
# MDM compliance engine URL (server/_core/env.ts)
MDM_GEOFENCE_SERVICE_URL=http://mdm-geofence:8083
# MDM geofencing service URL (server/_core/env.ts)
PBAC_ENGINE_URL=http://pbac-engine:8084
# PBAC (Policy-Based Access Control) engine URL
CONNECTIVITY_RESILIENCE_URL=http://connectivity:8085
# Connectivity resilience service URL
BILLING_AGGREGATOR_URL=http://billing-aggregator:8086
# Billing aggregator service URL
RBAC_SERVICE_URL=http://rbac-service:8087
# RBAC service URL
USSD_GATEWAY_URL=http://ussd-gateway:8088
# USSD gateway service URL
USSD_TX_PROCESSOR_URL=http://ussd-tx:8089
# USSD transaction processor URL
HIERARCHY_ENGINE_URL=http://hierarchy-engine:8090
# Hierarchy/engine URL
SETTLEMENT_GATEWAY_URL=http://settlement-gateway:8091
# Settlement gateway URL
AT_USSD_HANDLER_URL=http://at-ussd:8092
# Africa's Talking USSD handler URL
REVENUE_RECONCILER_URL=http://revenue-reconciler:8094
# Revenue reconciler service URL
CIRCUIT_BREAKER_URL=http://circuit-breaker:8080
# Circuit breaker service URL

# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM SERVICE URLs
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts
PLATFORM_KYC_URL=http://kyc:8080
# Platform KYC service URL
PLATFORM_NOTIFICATION_URL=http://notifications:8080
# Platform notification service URL
PLATFORM_FRAUD_URL=http://fraud:8103
# Platform fraud detection URL
PLATFORM_SETTLEMENT_URL=http://settlement:8080
# Platform settlement URL
PLATFORM_DISPUTE_URL=http://disputes:8080
# Platform dispute resolution URL
PLATFORM_FLOAT_URL=http://float:8107
# Platform float management URL
PLATFORM_GEOFENCING_URL=http://geofencing:8105
# Platform geofencing URL
PLATFORM_LOYALTY_URL=http://loyalty:8106
# Platform loyalty rewards URL
PLATFORM_VIDEO_KYC_URL=http://video-kyc:8080
# Platform video KYC URL
PLATFORM_ANALYTICS_URL=http://analytics:8080
# Platform analytics URL

# ─────────────────────────────────────────────────────────────────────────────
# AI / ML SERVICES
# ─────────────────────────────────────────────────────────────────────────────
PYTHON_ML_URL=http://ml-service:8080
# Python ML inference service URL
ML_MODEL_REGISTRY_URL=http://model-registry:8080
# ML model registry URL
FRAUD_ML_URL=http://fraud-ml:8080
# ML-based fraud detection service URL
INTELLIGENCE_SERVICE_URL=http://intelligence:8080
# AI intelligence service URL
ANALYTICS_SERVICE_URL=http://analytics:8080
# Analytics service URL

# ─────────────────────────────────────────────────────────────────────────────
# DATA LAKEHOUSE (Iceberg / Trino)
# ─────────────────────────────────────────────────────────────────────────────
LAKEHOUSE_URL=http://lakehouse:8181
# Data lakehouse service URL
LAKEHOUSE_SERVICE_URL=http://lakehouse-service:8181
# Lakehouse service URL
LAKEHOUSE_SIDECAR_URL=http://lakehouse-sidecar:8181
# Lakehouse sidecar URL
LAKEHOUSE_SERVICE_TOKEN=
# Lakehouse service authentication token
LAKEHOUSE_CATALOG=iceberg
# Lakehouse catalog name
LAKEHOUSE_SCHEMA=ngapp_analytics
# Lakehouse default schema
TRINO_URL=http://trino:8080
# Trino query engine URL

# ─────────────────────────────────────────────────────────────────────────────
# OTHER PLATFORM SERVICES
# ─────────────────────────────────────────────────────────────────────────────
# ── Resilience / Offline ─────────────────────────────────────────────────────
RESILIENCE_AGENT_URL=http://resilience-agent:8080
# Resilience agent service URL (server/_core/env.ts)
OFFLINE_QUEUE_URL=http://offline-queue:8201
# Offline queue service URL (server/_core/env.ts)
# ── POS / Printing ───────────────────────────────────────────────────────────
POS_PRINTER_URL=http://pos-printer:8080
# POS printer service URL (server/_core/env.ts)
RUST_BRIDGE_URL=http://rust-bridge:8080
# Rust bridge service URL
# ── Governance / Reporting ───────────────────────────────────────────────────
CBN_REPORTING_SERVICE_URL=http://cbn-reporting:8080
# Central Bank reporting service URL
CBN_TIER_ENGINE_URL=http://cbn-tier:8080
# CBN tier classification engine URL
# ── Marketplaces ─────────────────────────────────────────────────────────────
MARKETPLACE_URL=http://marketplace:8080
# Marketplace service URL
CART_SERVICE_URL=http://cart-service:8080
# Shopping cart service URL
CATALOG_SERVICE_URL=http://catalog-service:8080
# Product catalog service URL
# ── Operations ───────────────────────────────────────────────────────────────
BACKUP_MANAGER_URL=http://backup-manager:8080
# Backup manager service URL
DATA_ARCHIVAL_URL=http://data-archival:8080
# Data archival service URL
SUPPLY_CHAIN_URL=http://supply-chain:8080
# Supply chain service URL
WEBHOOK_DELIVERY_URL=http://webhook-delivery:8080
# Webhook delivery service URL

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite — VITE_ prefix is exposed to browser code)
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_ID=ngapp
# Frontend app ID (exposed to browser via Vite)
VITE_ANALYTICS_ENDPOINT=https://analytics.your-domain.com
# Vite frontend analytics collection endpoint

# ─────────────────────────────────────────────────────────────────────────────
# FORGE / BUILT-IN SERVICES
# ─────────────────────────────────────────────────────────────────────────────
# Used by: server/_core/env.ts
BUILT_IN_FORGE_API_URL=
# Built-in Forge API endpoint URL
BUILT_IN_FORGE_API_KEY=
# Built-in Forge API key

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
DEMO_MODE=false
# Enable demo mode with synthetic data
OWNER_OPEN_ID=
# Owner OpenID for platform administration

# ══════════════════════════════════════════════════════════════════════════════
# END — .env.example
# Copy to .env and set all marked values for production.
# At minimum, set: DB_PASSWORD, REDIS_PASSWORD, JWT_SECRET, KEYCLOAK_CLIENT_SECRET,
#                  PLATFORM_API_KEY, PLATFORM_SERVICE_TOKEN, MINIO_SECRET_KEY,
#                  APISIX_ADMIN_KEY, TERMII_API_KEY, TX_SIGNING_SECRET,
#                  INTERNAL_API_KEY, CRON_SECRET, VAULT_ROLE_ID, MINIO_ACCESS_KEY
# ══════════════════════════════════════════════════════════════════════════════
